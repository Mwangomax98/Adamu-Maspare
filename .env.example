# GEMINI_API_KEY: Optional — for future AI features
GEMINI_API_KEY=

# Frontend → API base path (Vite proxies /api to Express in dev)
VITE_API_URL=/api
# Set to "false" to force localStorage-only offline mode
VITE_USE_API=true

# Express API
PORT=3001
JWT_SECRET=change-this-to-a-long-random-secret

# MySQL (VPS: use 127.0.0.1 — do not expose MySQL publicly)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=adamu
DB_PASSWORD=your_mysql_password
DB_NAME=adamu_maspare

# Bootstrap Admin (npm run db:bootstrap) — username is always "admin"
ADMIN_PASSWORD=ChangeMeNow!

# Public URL (optional)
APP_URL=http://169.58.51.195
